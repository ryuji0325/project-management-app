rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= HELPER FUNCTIONS =================

    // 1. Check Login
    function isSignedIn() {
      return request.auth != null;
    }

    // 2. Check Supervisor (Role dari User Collection)
    function isSupervisor() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Supervisor';
    }

    // 3. Check Org Chart Member (dengan null safety)
    function isOrgMember(projectData) {
      let org = projectData.orgChart;
      return org != null && (
        request.auth.uid == org.manager ||
        request.auth.uid == org.leader ||
        (org.operation is list && request.auth.uid in org.operation)
      );
    }

    // ================= COLLECTION RULES =================

    // --- 1. USERS (Profile) ---
    match /users/{userId} {
      // Semua staff boleh baca senarai users (untuk dropdown assign task, org chart, dll)
      allow read: if isSignedIn();
      
      // User boleh edit profil sendiri, Supervisor boleh edit sesiapa
      allow write: if isSignedIn() && (request.auth.uid == userId || isSupervisor());
    }

    // --- 2. PROJECTS (Main Collection) ---
    match /projects/{projectId} {
      
      // VIEW & CREATE: Semua staff boleh tengok dan buat projek
      allow read, create: if isSignedIn();

      // EDIT/DELETE: Hanya Supervisor ATAU Ahli dalam Org Chart
      allow update, delete: if isSignedIn() && (
        isSupervisor() || 
        isOrgMember(resource.data)
      );

      // --- SUBCOLLECTION: UPDATES ---
      match /updates/{updateId} {
        // Semua staff boleh baca
        allow read: if isSignedIn();
        
        // Semua staff boleh buat update baru
        allow create: if isSignedIn();
        
        // Edit/Delete: Supervisor, Org Chart member, ATAU pencipta update itu sendiri
        allow update, delete: if isSignedIn() && (
          isSupervisor() ||
          isOrgMember(get(/databases/$(database)/documents/projects/$(projectId)).data) ||
          resource.data.name == request.auth.token.name ||
          resource.data.createdBy == request.auth.uid
        );

        // --- NESTED: COMMENTS dalam Updates ---
        match /comments/{commentId} {
          allow read: if isSignedIn();
          
          // Semua staff boleh tulis komen
          allow create: if isSignedIn();
          
          // Edit/Delete komen: pemilik komen atau Supervisor
          allow update, delete: if isSignedIn() && (
            isSupervisor() ||
            resource.data.uid == request.auth.uid
          );
        }
      }

      // --- SUBCOLLECTION: FINANCE ---
      match /finance/{docId} {
        allow read: if isSignedIn();
        
        // Semua staff boleh urus kewangan (mengikut permintaan)
        allow write: if isSignedIn();
      }

      // --- SUBCOLLECTION: REMINDERS ---
      match /reminders/{reminderId} {
        // Semua staff boleh baca
        allow read: if isSignedIn();
        
        // Semua staff boleh buat reminder baru
        allow create: if isSignedIn();
        
        // Edit/Delete: Supervisor, Org Chart member, ATAU sesiapa (staff)
        // Kerana reminder adalah untuk kegunaan pasukan
        allow update, delete: if isSignedIn();
      }
    }
    
    // --- 3. GLOBAL REMINDERS (Pengumuman Syarikat) ---
    match /reminders/{reminderId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isSupervisor();
    }

    // --- 4. TASKS ---
    match /tasks/{taskId} {
      // Semua staff boleh buat task
      allow create: if isSignedIn();
      
      // Baca/Edit/Delete: Penghantar, Penerima, atau Supervisor
      allow read, update, delete: if isSignedIn() && (
        resource.data.from == request.auth.uid || 
        resource.data.to == request.auth.uid ||
        isSupervisor() 
      );
    }
  }
}
